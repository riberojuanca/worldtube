{
  "name": "worldtube",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.4",
  "description": "A local-first YouTube desktop client with persistent playback and independent tabs.",
  "author": "riberojuanca",
  "homepage": "https://github.com/riberojuanca/worldtube",
  "desktopName": "com.riberojuanca.worldtube.desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riberojuanca/worldtube.git"
  },
  "packageManager": "pnpm@12.4.1",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "build": "electron-vite build",
    "icons": "node scripts/generate-icons.cjs",
    "desktop:install": "node scripts/install-dev-desktop.cjs",
    "notices": "node scripts/prepare-third-party-notices.mjs",
    "site": "node scripts/prepare-site.mjs",
    "package": "corepack pnpm notices && corepack pnpm build && node scripts/bundle-botguard.mjs && electron-builder --publish never",
    "release": "corepack pnpm notices && corepack pnpm build && node scripts/bundle-botguard.mjs && electron-builder --publish always",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "bgutils-js": "^4.0.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.21.5",
    "googlevideo": "^4.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "shaka-player": "^5.1.12",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
